rules_version = '2';

// ============================================================================
// Mills Maths Tools — FIREBASE PROJECT: mmt-firebase-games
// ----------------------------------------------------------------------------
// The arcade / multiplayer project. NOT `mills-maths-tools` — nothing here
// touches the strict claim-based platform rules. No student or teacher
// identity, no results and no typed answers live in this project. Every client
// signs in anonymously and needs the room code to reach a room.
//
// Reference copy of the LIVE rules. Deploy by pasting the whole file into
// Firebase Console -> project mmt-firebase-games -> Firestore -> Rules -> Publish.
//
// Last reviewed: 2026-09-22 — FULL AUDIT (every page in the repo that loads Firebase,
// traced to its projectId and every doc()/collection() path it touches).
// nastyGameRooms added 2026-09-21. Previous full audit 2026-07-29 — full audit of every page in the site that talks
// to this project. Every game below was traced from its firebaseConfig through
// to the exact doc() path it reads and writes.
//
// AUDIT — pages on mmt-firebase-games and the path each one uses
// ----------------------------------------------------------------------------
//   games/fractional-hex.html          games/fraction-hex-path/rooms/{code}      OK
//   games/row-column-challenge.html    games/rows-columns-challenge/rooms/{code} OK
//   games/shikaku.html                 games/shikaku/rooms/{code}                OK
//   games/sudoku.html                  games/sudoku/rooms/{code}                 OK (2026-09-19)
//   games/chess.html                   games/chess/rooms/{code}                  OK (2026-09-19)
//   games/checkers.html                games/checkers/rooms/{code}               OK (2026-09-19)
//   games/cartesian-connect-4.html     games/cartesianConnect4/rooms/{code}      OK
//   games/nasty-game.html              nastyGameRooms/{code} (+ members, tables) ADDED 2026-09-21
//   games/closest-to-100.html is listed further down (closestTo100Games) — its
//   config uses single quotes, which is easy to miss in a search.
//
// CHECKED 2026-09-22 AND NEEDING NOTHING HERE
//   games/order-up.html, total-trail.html, dot-detective.html — NO Firebase at
//   all (share links + localStorage only). Note: CLAUDE.md describes an Order
//   Up "race mode" at games/order-up/rooms/{code}; the file in the repo has
//   none. If it is ever added, the games/{gameId}/rooms/{roomCode} rule
//   below already covers it.
//   mmt-screen/cloudSync.js -> screens/{id} on mills-maths-tools (the claims
//   project, firestore.golive.claims.rules), not this one.
//   No page in this project uses a query (where/getDocs). Deletes: Greedy Pig
//   and Taxed by the King (room, by its teacherUid), Number Sum Chain (own
//   member doc), The Nasty Game (host clears tables/members/room; a player
//   removes their own member doc) — each allowed by its block below.
//   games/closest-to-100.html          closestTo100Games/{code}                  OK
//   games/greedy-pig.html              greedyPigGames/{code}                     OK
//   games/battleships.html             coordinateBattleshipsGames/{code}         OK
//   games/taxed-by-the-king.html       taxedByKingGames/{code}                   OK
//   games/ultimate-tic-tac-toe.html    ultimateTicTacToeGames/{code}             OK
//   games/Maths Memory/index.html      mathMemoryGames/{code}                    ADDED BELOW
//   interactive-tools/stage-5/measurement-space/square-sum-chain/
//                                      squareChainRooms/{code} (+ members)       ADDED BELOW
//
// No page in this project uses a query or a list, and none writes to a
// subcollection other than the two above. Rooms are read one doc at a time by
// code.
//
// CHANGED IN THIS REVISION
// ----------------------------------------------------------------------------
//   ! 2026-09-22 REPAIR — the 2026-09-21 edit that added nastyGameRooms
//     overwrote the squareChainRooms/members rule and dropped the top of the
//     nastyGameRooms block. Both are restored here. If the 2026-09-21 file was
//     ever published, Number Sum Chain presence and Nasty Game rooms were being
//     denied until this one is.
//   + nastyGameRooms    — 2026-09-21, for The Nasty Game's online class mode.
//                         MUST BE PUBLISHED before that mode works: without it
//                         every create is denied (the page says so, and the
//                         computer and pass-and-play modes are unaffected).
//   + mathMemoryGames   — Maths Memory's online mode was being denied. Nothing
//                         in the previous ruleset matched its collection.
//   + squareChainRooms  — new, for Number Sum Chain.
//   - coordinateConnect4Games — REMOVED. Nothing in the site writes to it:
//                         Cartesian Connect 4 actually uses the
//                         games/cartesianConnect4/rooms/{code} structure, which
//                         the first block already covers. It was a permissive
//                         read/write rule on a collection nobody uses. If you
//                         want it back it is one block, same shape as the
//                         others.
//
// NOT IN THIS PROJECT — see the note at the bottom of the file
//   games/cartesian-capture.html and games/dots-and-boxes.html still point at
//   an OLDER Firebase project (`coordinate-connect-4`). Their rules belong
//   there, not here.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- General game room structure -------------------------------------
    // Fractional Hex          games/fraction-hex-path/rooms/{code}
    // Row & Column Challenge  games/rows-columns-challenge/rooms/{code}
    // Shikaku                 games/shikaku/rooms/{code}
    // Sudoku                  games/sudoku/rooms/{code}   (added 2026-09-19 — no rule change needed)
    // Chess                   games/chess/rooms/{code}    (added 2026-09-19 — no rule change needed)
    // Checkers                games/checkers/rooms/{code} (added 2026-09-19 — no rule change needed)
    // Cartesian Connect 4     games/cartesianConnect4/rooms/{code}
    match /games/{gameId}/rooms/{roomCode} {
      allow read, write: if request.auth != null;
    }

    // ---- Closest to 100 online multiplayer rooms -------------------------
    match /closestTo100Games/{roomCode} {
      allow read, write: if request.auth != null;
    }

    // ---- Greedy Pig classroom rooms --------------------------------------
    match /greedyPigGames/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.teacherUid == request.auth.uid;
    }

    // ---- Coordinate Battleships online multiplayer rooms -----------------
    match /coordinateBattleshipsGames/{roomCode} {
      allow read, write: if request.auth != null;
    }

    // ---- Taxed by the King classroom rooms -------------------------------
    match /taxedByKingGames/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.teacherUid == request.auth.uid;
    }

    // ---- Ultimate Tic-Tac-Toe online multiplayer rooms -------------------
    match /ultimateTicTacToeGames/{roomCode} {
      allow read, write: if request.auth != null;
    }

    // ---- Maths Memory online rooms  (NEW — was missing) ------------------
    // games/Maths Memory/index.html. Uses getDoc, setDoc, updateDoc,
    // runTransaction and onSnapshot, so it needs read + write.
    match /mathMemoryGames/{roomCode} {
      allow read, write: if request.auth != null;
    }

    // ======================================================================
    // Number Sum Chain collaboration rooms  (NEW)
    // interactive-tools/stage-5/measurement-space/square-sum-chain/
    // ----------------------------------------------------------------------
    // squareChainRooms/{CODE}
    //   createdAt, updatedAt   timestamps
    //   state.pos.p{1..15}     { x, y } tile positions as fractions of the board
    //   state.slots            array of 15 numbers (0 = an empty space)
    //   state.wires.w{a}_{b}   { a, b } a join the students drew
    //   state.inks.k...        { pts:[[x,y],...], col, by } one pen stroke
    //   state.checked          has Check been pressed on this arrangement
    // squareChainRooms/{CODE}/members/{uid}
    //   name, colour, cx, cy, at   presence + live cursor (first name only)
    //
    // Deliberately tighter than the older game blocks: the document shape is
    // pinned, codes must look like codes, listing is denied so rooms cannot be
    // enumerated, and you may only write your OWN presence document.
    //
    // HOUSEKEEPING: rooms are throwaway. Add a Firestore TTL policy on
    // `updatedAt` for squareChainRooms (Firestore -> TTL) so old rooms delete
    // themselves — 14 days is plenty for classroom use.
    // ======================================================================
    match /squareChainRooms/{code} {

      function signedIn() { return request.auth != null; }
      function goodCode() { return code.matches('^[A-Z2-9]{4}$'); }
      function shape()    { return request.resource.data.keys().hasOnly(['createdAt','updatedAt','state'])
                                   && request.resource.data.state is map; }

      allow get: if signedIn();
      allow list: if false;                       // rooms cannot be enumerated

      allow create: if signedIn() && goodCode() && shape();
      allow update: if signedIn() && goodCode() && shape();
      allow delete: if false;                     // the TTL policy clears rooms

      // Presence + live cursor. You may only write your own member document.
      match /members/{uid} {
        allow get, list: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name','colour','cx','cy','at'])
          && (!('name' in request.resource.data) || request.resource.data.name.size() <= 14);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ======================================================================
    // The Nasty Game — online class rooms  (NEW 2026-09-21)
    // games/nasty-game.html
    // ----------------------------------------------------------------------
    // nastyGameRooms/{CODE}                 the room: host, settings, seating,
    //   hostUid, hostName, hostPlays,       and the class leaderboard
    //   status 'lobby'|'playing'|'finished', settings, gen, tableIds,
    //   seatTable {uid: tableId}, scores {uid: {name,total,rounds,done,tid,nasty}},
    //   createdAtMs, updatedAtMs, expireAt
    // nastyGameRooms/{CODE}/members/{uid}   the lobby — { name, joinedAtMs, expireAt, hostUid }
    // nastyGameRooms/{CODE}/tables/{tid}    one table of 2–4 players —
    //   { gen, hostUid, uids[], names[], g (game state as a JSON string), seq,
    //     lastMoveAtMs, expireAt }
    //
    // Who may do what:
    //   * only the HOST (whoever created the room) changes the room's settings,
    //     status and seating, deals and deletes tables, removes a member, or
    //     deletes the room;
    //   * anyone signed in may update ONLY the room's `scores` (and
    //     `updatedAtMs`) — a table writes its players' totals when a round ends;
    //   * a player writes only their OWN member doc, and only while the room is
    //     in the lobby, so nobody slips into a game that has started;
    //   * a table is written only by the players seated at it (or the host), and
    //     a move can never change who is seated there.
    // Members and tables carry the room's hostUid so the host can delete them
    // in one batch WITHOUT a get() of the room per document (rules cap how
    // many get()s one request may make).
    // Codes are 5 characters from A–Z/2–9 without I, O, 0, 1; listing rooms is
    // denied so they cannot be enumerated.
    //
    // HOUSEKEEPING: every doc carries `expireAt` (3 days on). Add TTL policies
    // on `expireAt` for the collection groups nastyGameRooms, members and
    // tables (Firestore -> TTL) and old rooms delete themselves.
    // ======================================================================
    match /nastyGameRooms/{code} {

      function signedIn()  { return request.auth != null; }
      function goodCode()  { return code.matches('^[A-HJ-NP-Z2-9]{5}$'); }
      function roomData()  { return get(/databases/$(database)/documents/nastyGameRooms/$(code)).data; }

      allow get:    if signedIn();
      allow list:   if false;
      allow create: if signedIn() && goodCode()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'lobby';
      allow update: if signedIn() && (
                      (resource.data.hostUid == request.auth.uid
                        && request.resource.data.hostUid == resource.data.hostUid)
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores', 'updatedAtMs'])
                    );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /members/{uid} {
        allow get, list: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && roomData().status == 'lobby'
          && request.resource.data.hostUid == roomData().hostUid
          && request.resource.data.keys().hasOnly(['name', 'joinedAtMs', 'expireAt', 'hostUid'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24;
        allow delete: if signedIn()
          && (request.auth.uid == uid || resource.data.hostUid == request.auth.uid);
      }

      match /tables/{tid} {
        allow get, list: if signedIn();
        allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
        allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
        allow update: if signedIn()
          && (request.auth.uid in resource.data.uids || resource.data.hostUid == request.auth.uid)
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.uids == resource.data.uids
          && request.resource.data.gen == resource.data.gen
          && request.resource.data.g is string
          && request.resource.data.g.size() < 60000;
      }
    }

    // ======================================================================
    // Everything else in this project is denied by default.
    // ======================================================================
  }
}

// ============================================================================
// SEPARATE PROJECT — `coordinate-connect-4`
// ----------------------------------------------------------------------------
// Two games were never migrated off the old project and still point at it:
//
//   games/cartesian-capture.html   ->  captureGridRooms/{code}
//                                      (also captureGridRooms/currentRoom)
//   games/dots-and-boxes.html      ->  dotsAndBoxesGames/{code}
//
// Their rules belong in THAT project's console, not this file. If its rules
// are missing these blocks, both games' online modes are being denied:
//
//   match /captureGridRooms/{roomCode} {
//     allow read, write: if request.auth != null;
//   }
//   match /dotsAndBoxesGames/{roomCode} {
//     allow read, write: if request.auth != null;
//   }
//
// Longer term these two are the last things holding the fourth Firebase
// project open — shikaku.html already contains a guard that refuses to run
// against `coordinate-connect-4`, so a migration was clearly started. Pointing
// both files at the mmt-firebase-games config (and adding the two blocks above
// to this file) would let that project be closed.
// ============================================================================
